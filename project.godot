; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Ночь охотника: Неон"
config/version="0.14.23"
run/main_scene="res://splash.tscn"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.02, 0.01, 0.04, 1)
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
config/quit_on_go_back=false

[autoload]

Updater="*res://scripts/updater.gd"
Settings="*res://scripts/settings.gd"
Sound="*res://scripts/audio.gd"
Net="*res://scripts/net.gd"
Touch="*res://scripts/touch_controls.gd"
Loader="*res://scripts/loader.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=3
window/stretch/mode="viewport"
window/handheld/orientation=6

[editor]

run/main_run_args="--gpu-index 0"

[rendering]

driver/threads/thread_model=2
driver/threads/thread_model.mobile=1

rendering_device/driver.windows="vulkan"
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true

textures/canvas_textures/default_texture_filter=0
viewport/hdr_2d=true

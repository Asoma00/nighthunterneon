static func is_hero_level(i: int) -> bool:
	return i >= BASE and i < BASE + ORDER.size() * STEPS


static func hero_of(i: int) -> String:
	return ORDER[(i - BASE) / STEPS] if is_hero_level(i) else ""


static func step_of(i: int) -> int:
	return (i - BASE) % STEPS


static func index_of(hero: String, step: int) -> int:
	return BASE + ORDER.find(hero) * STEPS + step


static func level(i: int) -> Dictionary:
	if not is_hero_level(i):
		return {}
	return CHAPTERS[hero_of(i)]["levels"][step_of(i)]


static func boss_by_id(id: String) -> Dictionary:
	if id.begins_with("g"):
		# Страж зала: «gh001-0» — страж уровня владыки h001, зал 0
		var src := boss_by_id(id.substr(1).get_slice("-", 0))
		if src.is_empty():
			return {}
		var g := src.duplicate()
		g["id"] = id
		g["name"] = "Страж — " + str(src["name"])
		g["hp"] = 0.75
		g["sz"] = 0.9
		return g
	for h in ORDER:
		for lv in CHAPTERS[h]["levels"]:
			if lv["boss"]["id"] == id:
				return lv["boss"]
	return {}

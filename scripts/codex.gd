static func is_open(e: Dictionary) -> bool:
	if not e.has("c"):
		return true
	return Meta.cond_met(e["c"])


static func get_entry(id: String) -> Dictionary:
	for e in CODEX:
		if e["id"] == id:
			return e
	return {}

	["Квинтэссенция", "Эффект модуля +50%", {"boost": 0.5}]]
const MODULE_NAMES := {
	"hp": ["Сердце-реактор", "Живучесть"], "speed": ["Форсаж", "Плавный ход"], "magnet": ["Гравитон", "Поле сбора"],
	"regen": ["Нанорой", "Симбионт"], "armor": ["Тяжёлые пластины", "Кевлар"], "vamp": ["Кровосос", "Донор"],
	"luck": ["Джекпот", "Талисман"], "damage": ["Перегрузка", "Точная настройка"], "cooldown": ["Овердрайв", "Кулер"],
	"area": ["Расширитель", "Фокусировка"], "crit": ["Убийца", "Прицел"], "multi": ["Дубликатор", "Синхронизатор"],
	"duration": ["Консервант", "Стабилизатор поля"],
}

const ROWS := [Vector2(0.5, 7), Vector2(2.5, 7), Vector2(0.5, 8), Vector2(2.5, 8), Vector2(1.5, 9)]
const IDS := ["spec_a", "spec_b", "sig_a", "sig_b", "ult"]


static func nodes(tree_key: String) -> Array:
	var kind := tree_key.left(2)
	var subj := tree_key.substr(2)
	var src: Array = []
	if kind == "w:":
		src = WEAPON.get(subj, [])
	elif kind == "c:":
		src = HERO.get(subj, [])
	elif kind == "m:":
		src = MODULE_PATHS.duplicate(true)
		var nm: Array = MODULE_NAMES.get(subj, [])
		if nm.size() == 2:
			src[0] = [nm[0], src[0][1], src[0][2]]
			src[1] = [nm[1], src[1][1], src[1][2]]
	if src.size() < 5:
		return []
	var modules := kind == "m:"
	var out: Array = []
	for i in 5:
		var e: Array = src[i]
		var n := {"id": IDS[i], "name": e[0], "desc": e[1], "fx": e[2], "pos": ROWS[i] - (Vector2(0, 2) if modules else Vector2.ZERO),
			"tier": [3, 3, 4, 4, 5][i] - (1 if modules else 0), "cost": [240, 240, 380, 380, 700][i], "req": []}
		if i < 2:
			n["excl"] = "path"
			n["desc"] = "ПУТЬ (только один): " + str(e[1])
		elif i < 4:
			n["req"] = [IDS[i - 2]]
			n["conds"] = [["wkills", 1500]] if kind == "w:" else ([["hkills", 2000]] if kind == "c:" else [["mused", 6]])
		else:
			n["req_any"] = ["sig_a", "sig_b"]
			n["conds"] = [["endless", 10]]
		out.append(n)
	return out


## Сумма прибавок fx изученных личных узлов.
static func fx_sum(tree_key: String, owned: Array) -> Dictionary:
	var out := {}
	for n in nodes(tree_key):
		if not (n["id"] in owned):
			continue
		var fx: Dictionary = n["fx"]
		for k in fx:
			if k in ["cooldown", "speed", "elite", "execute", "magnet", "xp", "ability_cd"] and not (tree_key.begins_with("w:") and k == "speed"):
				out[k] = float(out.get(k, 1.0)) * float(fx[k])
			else:
				out[k] = float(out.get(k, 0.0)) + float(fx[k])
	return out

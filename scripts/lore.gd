static func perk(id: String) -> int:
	return int(Meta.perks.get(id, 0))


static func perk_points() -> int:
	var spent := 0
	for k in Meta.perks:
		spent += int(Meta.perks[k])
	return rank() + int(Meta.stats.get("bonus_points", 0)) - spent


static func can_buy_perk(id: String) -> bool:
	return perk_points() > 0 and perk(id) < int(PERKS[id]["max"])


static func buy_perk(id: String) -> bool:
	if not can_buy_perk(id):
		return false
	Meta.perks[id] = perk(id) + 1
	Meta.save()
	return true


static func reset_perks() -> void:
	Meta.perks = {}
	Meta.save()


# ---------------- Мастерство героя ----------------

const MASTERY_XP := [0, 250, 600, 1100, 1700, 2500, 3500, 4700, 6100, 7800, 10000]
const TALE_AT := [2, 5, 8]


static func mastery_xp(hero: String) -> int:
	return int(Meta.mastery.get(hero, 0))


static func mastery(hero: String) -> int:
	var xp := mastery_xp(hero)
	var lv := 0
	for i in MASTERY_XP.size():
		if xp >= MASTERY_XP[i]:
			lv = i
	return lv


static func mastery_bonus(hero: String) -> Dictionary:
	var lv := mastery(hero)
	return {"damage": 0.02 * lv, "hp": 4.0 * lv}


## Открытые страницы истории героя (0..3; 3-я — «Эхо», за знамение).
static func tales_open(hero: String) -> Array:
	var out: Array = []
	var lv := mastery(hero)
	for i in TALE_AT.size():
		out.append(lv >= TALE_AT[i])
	out.append(bool(Meta.stats.get("echo", {}).get(hero, false)))
	return out



static func beast_base(kind: String) -> String:
	return BEAST_BASE.get(kind, kind)


static func beast_kills(kind: String) -> int:
	return int(Meta.stats.get("ekills", {}).get(beast_base(kind), 0))


static func beast_tier(kind: String) -> int:
	var k := beast_kills(kind)
	var t := 0
	for i in BEAST_TIERS.size():
		if k >= BEAST_TIERS[i]:
			t = i + 1
	return t


## Множители урона по видам врагов на эту вылазку (кэш — считается в начале боя).
static var beast_k := {}


static func prepare_run() -> void:
	beast_k.clear()
	var Data := preload("res://scripts/data.gd")
	for k in Data.ENEMIES:
		var t := beast_tier(k)
		if t > 0:
			beast_k[k] = 1.0 + 0.05 * t



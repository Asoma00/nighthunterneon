static func memory_id(ch: int, i: int) -> String:
	return "%d:%d" % [ch, i]


static func memory_count(ch: int) -> int:
	var n := 0
	for i in MEMORIES[ch].size():
		if memory_id(ch, i) in Meta.memories:
			n += 1
	return n


static func set_done(ch: int) -> bool:
	return memory_count(ch) >= MEMORIES[ch].size()


## Следующий ненайденный осколок главы (или "").
static func next_memory(ch: int) -> String:
	ch = clampi(ch, 0, MEMORIES.size() - 1)
	for c in range(ch, -1, -1):
		for i in MEMORIES[c].size():
			if not (memory_id(c, i) in Meta.memories):
				return memory_id(c, i)
	return ""


static func memory(id: String) -> Dictionary:
	var p := id.split(":")
	return MEMORIES[int(p[0])][int(p[1])]



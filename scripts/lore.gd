extends RefCounted
## Лор, привязанный к игре, и долгая прогрессия охотника.
##
##  • Ранг охотника — общий опыт за все вылазки. Каждый ранг даёт очко навыка,
##    навыки (перки) постоянно усиливают любого героя.
##  • Мастерство героя — опыт вылазок этим героем. Уровни дают урон и здоровье,
##    а на 2/5/8 уровне открывают страницы его истории.
##  • Бестиарий — чем больше тварей одного вида убито, тем больше о них известно
##    и тем сильнее по ним бьёт охотник (+5/10/15%).
##  • Осколки памяти — редкие находки в бою. Каждый — кусочек правды о Слиянии и Хоре.
##    Собрал все осколки главы — постоянный бонус.
##  • Саги жителей — многоэтапные просьбы. Каждый этап — отдельная вылазка,
##    финал — очко навыка и запись в летописи.

const Meta := preload("res://scripts/meta.gd")

# ---------------- Ранг охотника ----------------

const RANK_TITLES := ["Новобранец", "Дозорный", "Следопыт", "Охотник", "Ловчий", "Ветеран", "Страж стены",
	"Гроза бесов", "Клинок убежища", "Истребитель", "Гроза Врат", "Мастер ночи", "Легенда убежища", "Тень Хора",
	"Последний свет"]


static func rank_need(r: int) -> int:
	## Сколько опыта нужно, чтобы с ранга r перейти на r + 1.
	return 300 + 140 * r


static func rank_of(xp: int) -> Array:
	## [ранг, опыт внутри ранга, нужно до следующего]
	var r := 0
	var left := xp
	while left >= rank_need(r) and r < 99:
		left -= rank_need(r)
		r += 1
	return [r, left, rank_need(r)]


static func rank() -> int:
	return int(rank_of(Meta.rank_xp)[0])


static func rank_title(r := -1) -> String:
	if r < 0:
		r = rank()
	return RANK_TITLES[mini(r / 3, RANK_TITLES.size() - 1)]


## Опыт за вылазку (и для ранга, и для мастерства героя).
static func run_xp(run: Dictionary, victory: bool) -> int:
	var xp := int(run.get("kills", 0)) / 4 + int(run.get("minutes", 0)) * 25 + int(run.get("boss", 0)) * 120
	xp += int(run.get("elites", 0)) * 10 + int(run.get("events", 0)) * 30 + int(run.get("omens", 0)) * 80
	xp += int(run.get("puzzles", 0)) * 50 + int(run.get("beacons", 0)) * 40 + int(run.get("caches", 0)) * 30
	xp += int(run.get("memories", 0)) * 100
	if victory:
		xp += 200
	return xp



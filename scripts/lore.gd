static func saga_stage(nm: String) -> int:
	return int(Meta.sagas.get(nm, 0))


static func saga_done(nm: String) -> bool:
	return SAGAS.has(nm) and saga_stage(nm) >= SAGAS[nm]["steps"].size()


## Задание текущего этапа саги (или пустой словарь).
static func saga_quest(nm: String) -> Dictionary:
	if not SAGAS.has(nm) or saga_done(nm):
		return {}
	var n := saga_stage(nm)
	var s: Array = SAGAS[nm]["steps"][n]
	return {"k": s[0], "g": int(s[1]), "tier": 2, "giver": nm, "saga": nm, "stage": n,
		"title": s[2], "text": s[3], "steps": SAGAS[nm]["steps"].size()}


## Этап саги выполнен. Возвращает текст финала, если сага завершена.
static func saga_advance(nm: String) -> String:
	Meta.sagas[nm] = saga_stage(nm) + 1
	if saga_done(nm):
		Meta.stats["bonus_points"] = int(Meta.stats.get("bonus_points", 0)) + 1
		return str(SAGAS[nm]["final"])
	return ""


# ---------------- Бонусы для боя ----------------

## Добавка к бонусам убежища (Meta.run_mods): навыки и наборы осколков.
static func apply_run_mods(m: Dictionary) -> void:
	m["damage"] = float(m["damage"]) * (1.0 + 0.03 * perk("edge")) * (1.05 if set_done(0) else 1.0)
	m["hp"] = float(m["hp"]) + 6.0 * perk("vigor") + (15.0 if set_done(1) else 0.0)
	m["cooldown"] = float(m["cooldown"]) * (1.0 - 0.03 * perk("focus")) * (0.95 if set_done(2) else 1.0)
	m["magnet"] = float(m["magnet"]) * (1.0 + 0.1 * perk("magnet"))
	m["xp"] = float(m["xp"]) * (1.0 + 0.04 * perk("scholar")) * (1.08 if set_done(2) else 1.0)
	m["chest"] = float(m["chest"]) + 0.04 * perk("luck")
	m["revive"] = perk("second")
	# Благословение из убежища — на одну вылазку
	match str(Meta.stats.get("buff", "")):
		"well":
			m["xp"] = float(m["xp"]) * 1.08
		"fire":
			m["damage"] = float(m["damage"]) * 1.05
		"train":
			m["cooldown"] = float(m["cooldown"]) * 0.94
		"garden":
			m["hp"] = float(m["hp"]) + 15.0


# ---------------- Итоги вылазки ----------------

## Вызывается из Meta.finish_run: опыт ранга и мастерства, бестиарий, осколки.
static func settle(run: Dictionary, victory: bool) -> Dictionary:
	var out := {}
	if run.is_empty():
		return out
	var hero: String = run.get("hero", "")
	var xp := run_xp(run, victory)
	var r0 := rank()
	Meta.rank_xp += xp
	var r1 := rank()
	out["rank_xp"] = xp
	out["rank"] = r1
	out["rank_up"] = r1 - r0
	if hero != "":
		var m0 := mastery(hero)
		Meta.mastery[hero] = mastery_xp(hero) + xp
		var m1 := mastery(hero)
		out["mastery"] = m1
		out["mastery_up"] = m1 - m0
		var pages: Array = []
		for i in TALE_AT.size():
			if m0 < TALE_AT[i] and m1 >= TALE_AT[i]:
				pages.append(i + 1)
		out["tales"] = pages
	# Бестиарий: новые ступени знаний
	var ek: Dictionary = Meta.stats.get("ekills", {})
	var ups: Array = []
	for k in run.get("ekills", {}):
		var base := beast_base(k)
		var before := beast_tier(base)
		ek[base] = int(ek.get(base, 0)) + int(run["ekills"][k])
		Meta.stats["ekills"] = ek
		var after := beast_tier(base)
		if after > before:
			ups.append([base, after])
	Meta.stats["ekills"] = ek
	out["beasts"] = ups
	out["memories"] = run.get("mem_ids", [])
	return out


## Строки итогов для экрана конца боя и убежища.
static func summary_lines(p: Dictionary) -> Array:
	var Story := preload("res://scripts/story.gd")
	var Data := preload("res://scripts/data.gd")
	var out: Array = []
	if p.is_empty():
		return out
	var ro := rank_of(Meta.rank_xp)
	out.append("Ранг охотника: %d — %s  (+%d опыта, %d / %d)" % [int(ro[0]), rank_title(int(ro[0])), int(p.get("rank_xp", 0)), int(ro[1]), int(ro[2])])
	if int(p.get("rank_up", 0)) > 0:
		out.append("★ НОВЫЙ РАНГ! Очков навыков: %d — потратьте у Монумента охотников" % perk_points())
	if p.has("mastery"):
		var t := "Мастерство героя: ур. %d" % int(p["mastery"])
		if int(p.get("mastery_up", 0)) > 0:
			t += "  ▲ +%d (урон и здоровье героя выросли)" % int(p["mastery_up"])
		out.append(t)
	for pg in p.get("tales", []):
		out.append("📖 Открыта страница истории героя (%d / 3)" % int(pg))
	for b in p.get("beasts", []):
		var nm: String = Story.ENEMY_INFO.get(b[0], {}).get("name", b[0])
		out.append("Бестиарий: «%s» — знание %d/3, урон по ним +%d%%" % [nm, int(b[1]), 5 * int(b[1])])
	for id in p.get("memories", []):
		out.append("✦ Осколок памяти: «%s»" % memory(id)["t"])
	return out



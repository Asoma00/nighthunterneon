## Данные говорящего: CAST, герой по id или "player" — выбранный герой.
static func cast(who: String) -> Dictionary:
	if who == "":
		return {"name": "", "color": Color(0.75, 0.72, 0.9), "sprite": "", "side": "r"}
	if CAST.has(who):
		return CAST[who]
	var D = preload("res://scripts/data.gd")
	var h: String = D.selected_character if who == "player" else who
	if D.CHARACTERS.has(h):
		var c: Dictionary = D.CHARACTERS[h]
		return {"name": c["name"], "color": c["color"], "sprite": Meta.hero_sprite(h), "side": "l"}
	return {"name": who, "color": Color(0.85, 0.85, 0.95), "sprite": "", "side": "r"}


## Подстановки: {hero} — имя выбранного героя, {nick} — имя игрока.
static func fill(t: String) -> String:
	var D = preload("res://scripts/data.gd")
	return t.replace("{hero}", str(D.CHARACTERS.get(D.selected_character, D.CHARACTERS["vega"])["name"])).replace("{nick}", Meta.nickname)


static func get_scene(id: String) -> Array:
	if SCENES.has(id):
		return (SCENES[id] as Array).duplicate()
	if id.begins_with("brief_"):
		return brief(int(id.substr(6)))
	if id.begins_with("after_"):
		return after(int(id.substr(6)))
	return []


static func seen(id: String) -> bool:
	Meta.ensure_loaded()
	return id in Meta.dialogs_seen


static func mark(id: String) -> void:
	if not (id in Meta.dialogs_seen):
		Meta.dialogs_seen.append(id)



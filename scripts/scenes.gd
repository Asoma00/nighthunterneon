static func brief(level: int) -> Array:
	if level < 0 or level >= Story.LEVEL_STORY.size():
		return []
	var D = preload("res://scripts/data.gd")
	var h: String = D.selected_character
	var rep: Array = HERO_REPLY.get(h, HERO_REPLY["vega"])
	var ch := D.chapter_of(level)
	var out: Array = []
	if level % D.LEVELS_PER_CHAPTER == 0:
		out.append(["", str(Story.CHAPTERS[ch]["name"]) + ". " + str(Story.CHAPTERS[ch]["intro"])])
	out.append(["voron", "{hero}, на связи Ворон. " + str(Story.LEVEL_STORY[level]["brief"])])
	out.append(["player", rep[level % rep.size()]])
	return out


static func after(level: int) -> Array:
	if level < 0 or level >= Story.LEVEL_STORY.size():
		return []
	var out: Array = [["player", str(Story.LEVEL_STORY[level]["after"])]]
	if AFTER_EXTRA.has(level):
		out.append_array(AFTER_EXTRA[level])
	else:
		out.append(["voron", VORON_ACK[level % VORON_ACK.size()]])
	return out



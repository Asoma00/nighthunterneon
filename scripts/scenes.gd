## Имена жителей убежища → их id в CAST (чтобы портрет совпадал с тем, кто стоит на площади).
const BY_NAME := {"Ворон": "voron", "Бабушка Гедда": "gedda", "Селена": "selena", "Горн": "gorn", "Бруно": "bruno",
